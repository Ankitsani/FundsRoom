{
  "info": {
    "name": "Fundsroom Mini ERP & CRM API Collection",
    "description": "API collection covering Authentication, Customers CRM, Product Inventory, and Sales Challans with role-based restrictions and transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@fundsroom.com\",\n  \"password\": \"sales123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Me Endpoint (Verify Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers CRM",
      "item": [
        {
          "name": "Get Customers (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers?page=1&limit=10&search=Gupta",
              "host": ["{{base_url}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Gupta" }
              ]
            }
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            }
          }
        },
        {
          "name": "Create Customer (Wholesale)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Sharma\",\n  \"mobile\": \"9876123450\",\n  \"email\": \"rajesh@sharmatraders.com\",\n  \"businessName\": \"Sharma Traders\",\n  \"gstNumber\": \"07AAAAA1111A1Z1\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"32, MG Road, New Delhi\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers",
              "host": ["{{base_url}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Add CRM Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteText\": \"Discussed the discount levels. Client agreed to place order next week.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/notes",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}", "notes"]
            }
          }
        },
        {
          "name": "Create Customer [Failure - Malformed GSTIN]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid GST Corp\",\n  \"mobile\": \"9000000000\",\n  \"email\": \"invalid@gst.com\",\n  \"businessName\": \"Bad GST Ltd\",\n  \"gstNumber\": \"NOTAGSTIN123\",\n  \"customerType\": \"RETAIL\",\n  \"address\": \"10 Street\",\n  \"status\": \"LEAD\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers",
              "host": ["{{base_url}}"],
              "path": ["customers"]
            }
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "Get Products (All)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Products [Filter Low Stock]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?lowStock=true",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "lowStock", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Create Product (Admin/Warehouse)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Curved gaming monitor 32\\\"\",\n  \"sku\": \"MON-CRV-32\",\n  \"category\": \"Electronics\",\n  \"unitPrice\": 350.00,\n  \"currentStock\": 25,\n  \"minimumStockAlertQty\": 5,\n  \"location\": \"Warehouse 2, Row B\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Product & Audit Movement Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "Get Challans (List)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans",
              "host": ["{{base_url}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Create Challan as Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"status\": \"DRAFT\",\n  \"lineItems\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans",
              "host": ["{{base_url}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Confirm Challan (DRAFT -> CONFIRMED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans/{{challan_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["challans", "{{challan_id}}", "status"]
            }
          }
        },
        {
          "name": "Cancel Challan (CONFIRMED -> CANCELLED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans/{{challan_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["challans", "{{challan_id}}", "status"]
            }
          }
        },
        {
          "name": "Create Challan [Failure - Insufficient Stock]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"status\": \"CONFIRMED\",\n  \"lineItems\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 999999\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans",
              "host": ["{{base_url}}"],
              "path": ["challans"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "CUSTOMER_UUID_HERE",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "PRODUCT_UUID_HERE",
      "type": "string"
    },
    {
      "key": "challan_id",
      "value": "CHALLAN_UUID_HERE",
      "type": "string"
    }
  ]
}
